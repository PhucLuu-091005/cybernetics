{
  "name": "promise-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && cp -R .next/static .next/standalone/.next/ && cp -R public .next/standalone/",
    "start": "node .next/standalone/server.js",
    "eval": "vitest run tests/unit/contracts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "arctic": "3.7.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24 <27"
  }
}
