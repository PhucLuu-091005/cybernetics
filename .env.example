# demo: no sign-in, each visitor gets their own sandbox (the hosted app). google: Google sign-in.
# local: loopback development and tests only; refused when NODE_ENV=production.
AUTH_MODE=local
# Public origin, read at run time. Production requires https (Cloud Run: https://promise-graph-<project number>.asia-southeast1.run.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Only for AUTH_MODE=google. Google Cloud Console > APIs & Services > Credentials > OAuth client (Web). Redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_URL=postgresql://promise_graph:local-development-only@localhost:55432/promise_graph
# Optional: the direct (not -pooler) URL for scripts/migrate.mjs when DATABASE_URL is a Neon pooled URL.
# MIGRATE_DATABASE_URL=
# Profile photos. Leave AVATAR_STORE out to keep photos off (initials only).
# local: a folder for development and tests (AVATAR_DIR, default .avatars); refused when NODE_ENV=production.
# gcs: a private Cloud Storage bucket; Cloud Run reads its credentials from the service account.
# AVATAR_STORE=local
# AVATAR_DIR=.avatars
# AVATAR_BUCKET=promise-graph-avatars
