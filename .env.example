# Local mode is accepted only outside NODE_ENV=production, on loopback origins.
AUTH_MODE=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Generate a fresh secret with: openssl rand -hex 32
LOCAL_SESSION_SECRET=
DATABASE_URL=postgresql://promise_graph:local-development-only@localhost:55432/promise_graph
# Production requires AUTH_MODE=clerk and both Clerk keys; no automatic fallback.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
